# AWS CLI
# Optional: AWS CLI profile used by local scripts and deployment workflows.
AWS_CLI_PROFILE=your-aws-cli-profile
# Optional: AWS account ID for local reference and deployment scripts.
AWS_ACCOUNT_ID=your-aws-account-id
# Optional: AWS region for S3 and other AWS resources. Defaults to us-west-1 in the scraper.
AWS_REGION=us-west-1
# Required: S3 bucket name for fight data, models, and pipeline artifacts.
# Lambda functions use S3_BUCKET; the local scraper also accepts AWS_S3_BUCKET.
AWS_S3_BUCKET=your-s3-bucket-name

# Scraper
# Optional: S3 object key for historical fight events CSV. Lambda defaults to data/fight_events.csv.
S3_CSV_KEY=data/fight_events.csv
# Optional: S3 object key for upcoming fights JSON. Lambda defaults to data/upcoming_fights.json.
S3_JSON_KEY=data/upcoming_fights.json
# Required: base URL for scraping completed MMA event statistics pages.
EVENTS_URL=http://example.com/statistics/events/completed?page=all
